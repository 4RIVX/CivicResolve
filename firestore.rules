rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidLanguage(lang) {
      return lang in ['en', 'ta'];
    }

    // --- Entity Validation Blueprints ---
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'preferredLanguage', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'preferredLanguage', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == userId
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && isValidLanguage(data.preferredLanguage)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---

    // Private Citizen Profiles (PII isolated to verified owner only)
    match /users/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'preferredLanguage', 'updatedAt'])
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // Admin Directory: completely denied to client SDKs (server-side ADMIN_EMAILS allowlist only)
    match /admins/{userId} {
      allow read, write: if false;
    }

    // Citizen Complaints: client reads strictly isolated to owning citizen; all writes happen via trusted backend API
    match /complaints/{complaintId} {
      allow get: if isVerifiedUser() && isValidId(complaintId) && existing().citizenUid == request.auth.uid;
      allow list: if isVerifiedUser() && resource.data.citizenUid == request.auth.uid;
      allow create, update, delete: if false;

      // Subcollection: Status History (readable only by owning citizen, writes server-only)
      match /statusHistory/{historyId} {
        allow get: if isVerifiedUser() && isValidId(complaintId) && isValidId(historyId)
          && get(/databases/$(database)/documents/complaints/$(complaintId)).data.citizenUid == request.auth.uid;
        allow list: if isVerifiedUser() && isValidId(complaintId)
          && get(/databases/$(database)/documents/complaints/$(complaintId)).data.citizenUid == request.auth.uid;
        allow create, update, delete: if false;
      }

      // Subcollection: Internal Admin Notes (strictly hidden from client SDKs; served via verified /api/admin/*)
      match /adminNotes/{noteId} {
        allow read, write: if false;
      }
    }

    // Governance Audit Trail (write-protected and unreadable from client SDKs; backend Admin SDK only)
    match /auditLogs/{logId} {
      allow read, write: if false;
    }

    // Public Aggregate Statistics (zero PII, strictly server-write-only via Admin SDK)
    match /publicStats/{statId} {
      allow get: if isValidId(statId) && statId == 'aggregate';
      allow list, create, update, delete: if false;
    }
  }
}
