{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit.test.ts tests/imageSecurity.test.ts tests/promptInjection.test.ts tests/geminiService.test.ts tests/publicStatsCache.test.ts tests/firestoreAdminStore.test.ts tests/firestoreRestClient.test.ts",
    "test:integration": "vitest run tests/integration.test.ts tests/missionB.test.ts tests/rateLimitAndCors.test.ts tests/securityRegression.test.ts tests/firestore.rules.test.ts",
    "test:security": "vitest run tests/securityRegression.test.ts tests/rateLimitAndCors.test.ts tests/promptInjection.test.ts tests/imageSecurity.test.ts tests/firestore.rules.test.ts",
    "test:e2e": "playwright test",
    "test:emulator": "FIRESTORE_EMULATOR_TESTS=1 firebase emulators:exec --only firestore --project civicresolve-emulator-test \"vitest run tests/firestore.emulator.test.ts\"",
    "test:coverage": "vitest run --coverage && bun run check:coverage",
    "check:coverage": "node scripts/check-coverage.mjs",
    "lint": "tsc --noEmit && bun x eslint firestore.rules eslint.config.mjs",
    "typecheck": "tsc --noEmit"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "@opentelemetry/core": "^2.8.0",
    "glob": "^14.0.2",
    "minimatch": "^11.0.1",
    "uuid": "^11.1.1"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@google/genai": "^3.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.14.1",
    "dotenv": "^17.2.3",
    "eslint": "^10.15.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.5",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "helmet": "^8.3.0",
    "jsdom": "^31.0.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.6",
    "sharp": "^0.35.5",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.0",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "firebase-tools": "^15.37.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
