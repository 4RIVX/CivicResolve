# GEMINI_API_KEY: Required for server-side Gemini AI complaint classification.
# Configured automatically in Google AI Studio Secrets / Cloud Run environment.
GEMINI_API_KEY=

# GEMINI_MODEL: Centrally configurable free-tier Gemini Flash model identifier.
GEMINI_MODEL=gemini-4-hydrogen

# ADMIN_EMAILS: Comma-separated allowlist of verified administrator email addresses.
# Never trust client-supplied admin roles; authorization is checked exclusively against this server env var.
ADMIN_EMAILS=

# PORT: HTTP port for Express server (Cloud Run injects PORT; defaults to 3000).
PORT=3000

# APP_URL: Public URL of the hosted service.
APP_URL=
